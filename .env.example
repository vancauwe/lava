# Public env for the static site (safe to expose).

# Kit form POST URL from Embed → HTML → form action attribute.
# Example: https://app.kit.com/forms/1234567/subscriptions
# (or https://app.convertkit.com/forms/1234567/subscriptions)
PUBLIC_KIT_FORM_ACTION=

# In Kit form settings:
# 1. Set post-subscribe redirect to your live /newsletter/thanks/ URL
#    (include /lava base path on GitHub project Pages).
# 2. Disable double opt-in (Incentive → uncheck confirmation / enable auto-confirm).

# Optional: project GitHub Pages base path, e.g. /lava
# BASE_PATH=
